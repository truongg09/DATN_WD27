# ============================================================
# Sao chép file này thành .env rồi điền thông tin máy của bạn:
#   cp .env.example .env          (Windows: copy .env.example .env)
# File .env KHÔNG được đẩy lên Git.
# ============================================================

# --- Cơ sở dữ liệu MySQL (BẮT BUỘC) ---
# Giá trị dưới đây đúng với XAMPP/Laragon mặc định (user root, không mật khẩu).
# Nếu MySQL của bạn có mật khẩu thì điền vào DB_PASSWORD.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=hotelbookingdb

# Cổng chạy backend. Frontend mặc định gọi tới http://localhost:3001/api
PORT=3001

# --- Bảo mật ---
# Chuỗi bí mật để ký token đăng nhập, nên dài tối thiểu 32 ký tự.
# Bỏ trống cũng chạy được: server sẽ tự sinh và lưu vào backend/.jwt-secret,
# nhưng khi triển khai thật thì phải đặt giá trị riêng ở đây.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# --- Các phần TÙY CHỌN dưới đây có thể để trống, web vẫn chạy bình thường ---
# Chỉ cần điền khi muốn dùng thanh toán qua cổng VNPay/ZaloPay hoặc gửi email.

API_BASE_URL=https://your-public-api.example.com
FRONTEND_URL=http://localhost:5173
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Không dùng AppID mẫu v1 cũ 554; nhập AppID của ứng dụng Sandbox Gateway v2.
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_APP_USER=HotelBooking
ZALOPAY_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_URL=https://sb-openapi.zalopay.vn/v2/query

# SMTP email (ví dụ Gmail dùng App Password; không dùng mật khẩu đăng nhập thường)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HotelHub

# Thong tin lien he hien o cuoi email gui cho khach (de trong cung duoc).
SUPPORT_EMAIL=info@hotelhub.com
SUPPORT_PHONE=+84 123 456 789